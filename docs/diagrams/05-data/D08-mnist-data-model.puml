@startuml D08-MNIST-Data-Model
title D08 — MNIST Dataset Structure\n(IDX Binary Format)

skinparam defaultFontSize 11

package "data/mnist/raw/" {

    class "train-images-idx3-ubyte\n(IDX3 format)" as TI {
        magic      : uint32  = 0x00000803
        num_images : uint32  = 60,000
        num_rows   : uint32  = 28
        num_cols   : uint32  = 28
        --
        pixels[60000][28][28] : uint8
        (big-endian, values 0–255)
    }

    class "train-labels-idx1-ubyte\n(IDX1 format)" as TL {
        magic      : uint32 = 0x00000801
        num_items  : uint32 = 60,000
        --
        labels[60000] : uint8
        (values 0–9)
    }

    class "t10k-images-idx3-ubyte\n(IDX3 format)" as XI {
        magic      : uint32 = 0x00000803
        num_images : uint32 = 10,000
        num_rows   : uint32 = 28
        num_cols   : uint32 = 28
        --
        pixels[10000][28][28] : uint8
    }

    class "t10k-labels-idx1-ubyte\n(IDX1 format)" as XL {
        magic      : uint32 = 0x00000801
        num_items  : uint32 = 10,000
        --
        labels[10000] : uint8
    }
}

class "Dataset (in memory)" as DS {
    images      : real_t*\n  // normalised to [0,1]\n  // flat: [num_samples × 784]
    labels      : uint8_t*\n // [num_samples]
    num_samples : size_t
    image_size  : size_t = 784
}

TI --> DS : "load_mnist_images()\nnormalise: pixel/255.0"
TL --> DS : "load_mnist_labels()"
XI --> DS : "load_mnist_images()"
XL --> DS : "load_mnist_labels()"

note right of DS
  Images are flattened 28×28 → 784 floats.
  Pixel normalisation converts uint8 [0,255]
  to real_t [0.0, 1.0] in load_mnist_images().
  
  train_images and train_labels are matched
  by sample index; same for test split.
end note

@enduml
