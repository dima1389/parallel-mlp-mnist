{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Sequential",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/train_seq_dbg",
            "args": [
                "--config", "configs/small_network.conf",
                "--data", "data/mnist/raw"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Debug Sequential"
        },
        {
            "name": "Debug OpenMP",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/train_omp_dbg",
            "args": [
                "--config", "configs/small_network.conf",
                "--data", "data/mnist/raw",
                "--threads", "2"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "OMP_NUM_THREADS",
                    "value": "2"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Debug OpenMP"
        },
        {
            "name": "Debug MPI (single rank)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/train_mpi_dbg",
            "args": [
                "--config", "configs/small_network.conf",
                "--data", "data/mnist/raw"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Debug MPI"
        }
    ]
}
