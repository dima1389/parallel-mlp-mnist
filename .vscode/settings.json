{
    // --- File handling ---
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,

    // --- Editor defaults ---
    "editor.tabSize": 4,
    "editor.insertSpaces": true,

    // --- File associations ---
    "files.associations": {
        "*.h": "cpp",
        "*.conf": "properties"
    },

    // --- C/C++ ---
    "C_Cpp.default.cppStandard": "c++17",

    // --- Makefile (must use real tabs) ---
    "[makefile]": {
        "editor.insertSpaces": false
    },

    // --- Search: exclude generated/data directories ---
    "search.exclude": {
        "build/**": true,
        "data/**": true
    },
    "files.exclude": {
        "build/**": true
    }
}
