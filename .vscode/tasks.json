{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "configFile",
            "type": "pickString",
            "description": "Select network configuration",
            "options": [
                "small_network",
                "medium_network",
                "large_network",
                "test_benchmark"
            ],
            "default": "small_network"
        },
        {
            "id": "numThreads",
            "type": "pickString",
            "description": "Select number of OpenMP threads",
            "options": [
                "1",
                "2",
                "3",
                "4",
                "5",
                "6",
                "7",
                "8"
            ],
            "default": "2"
        },
        {
            "id": "numProcesses",
            "type": "pickString",
            "description": "Select number of MPI processes",
            "options": [
                "1",
                "2",
                "3",
                "4",
                "5",
                "6",
                "7",
                "8"
            ],
            "default": "2"
        },
        {
            "id": "numRuns",
            "type": "promptString",
            "description": "Number of repeated runs per configuration",
            "default": "1"
        }
    ],
    "tasks": [
        {
            "label": "Download MNIST Dataset",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "scripts/download_mnist.ps1"
            ],
            "detail": "Download and extract the MNIST handwritten digit dataset (4 files ~11MB) into data/mnist/raw/",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build All",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "mkdir -p results/logs && make all 2>&1 | tee results/logs/build_all.log"],
            "detail": "Build all three training binaries: train_seq, train_omp, train_mpi",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Sequential",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "mkdir -p results/logs && make seq 2>&1 | tee results/logs/build_seq.log"],
            "detail": "Build the sequential (single-threaded) training binary: build/train_seq",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build OpenMP",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "mkdir -p results/logs && make omp 2>&1 | tee results/logs/build_omp.log"],
            "detail": "Build the OpenMP parallelized training binary: build/train_omp",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build MPI",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "mkdir -p results/logs && make mpi 2>&1 | tee results/logs/build_mpi.log"],
            "detail": "Build the MPI distributed training binary: build/train_mpi",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "mkdir -p results/logs && make clean 2>&1 | tee results/logs/clean_build.log"],
            "detail": "Remove all compiled binaries and object files from build/",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build All Debug",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "mkdir -p results/logs && make debug 2>&1 | tee results/logs/build_debug.log"],
            "detail": "Build all three debug binaries with debug symbols (-g -O0): train_seq_dbg, train_omp_dbg, train_mpi_dbg",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Debug Sequential",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "mkdir -p results/logs && make debug-seq 2>&1 | tee results/logs/build_debug_seq.log"],
            "detail": "Build the sequential training binary with debug symbols (-g -O0): build/train_seq_dbg",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Debug OpenMP",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "mkdir -p results/logs && make debug-omp 2>&1 | tee results/logs/build_debug_omp.log"],
            "detail": "Build the OpenMP training binary with debug symbols (-g -O0): build/train_omp_dbg",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Debug MPI",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "mkdir -p results/logs && make debug-mpi 2>&1 | tee results/logs/build_debug_mpi.log"],
            "detail": "Build the MPI training binary with debug symbols (-g -O0): build/train_mpi_dbg",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Rebuild All",
            "detail": "Clean all build artifacts then rebuild all three training binaries from scratch",
            "group": "build",
            "dependsOn": ["Clean Build", "Build All"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Build & Run Tests",
            "type": "shell",
            "command": "make",
            "args": ["test"],
            "detail": "Build and run all unit tests (dataset loading, loss functions, MLP forward/backward)",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Train Sequential",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "NUM_RUNS=${input:numRuns} bash scripts/run_training.sh seq ${input:configFile}"
            ],
            "detail": "Train the MLP using the sequential (single-threaded) implementation with N repeated runs",
            "group": "none",
            "dependsOn": "Build Sequential",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Train OpenMP",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "NUM_RUNS=${input:numRuns} bash scripts/run_training.sh omp ${input:configFile} ${input:numThreads}"
            ],
            "detail": "Train the MLP using OpenMP shared-memory parallelization with N repeated runs",
            "group": "none",
            "dependsOn": "Build OpenMP",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Train MPI",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "NUM_RUNS=${input:numRuns} bash scripts/run_training.sh mpi ${input:configFile} ${input:numProcesses}"
            ],
            "detail": "Train the MLP using MPI distributed parallelization with N repeated runs",
            "group": "none",
            "dependsOn": "Build MPI",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Full Benchmark",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "NUM_RUNS=${input:numRuns} bash scripts/benchmark.sh"],
            "detail": "Run the complete benchmark suite across all configs (small/medium/large) and parallelism levels (1/8 threads/processes) with N repeated runs. Outputs a timestamped CSV to results/tables/",
            "group": "none",
            "dependsOn": "Build All",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Benchmark OpenMP",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "NUM_RUNS=${input:numRuns} SKIP_MPI=1 bash scripts/benchmark.sh"],
            "detail": "Run benchmark with sequential baseline + OpenMP (1-8 threads) across all configs. Skips MPI.",
            "group": "none",
            "dependsOn": "Build All",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Benchmark MPI",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "NUM_RUNS=${input:numRuns} SKIP_OMP=1 bash scripts/benchmark.sh"],
            "detail": "Run benchmark with sequential baseline + MPI (1-8 processes) across all configs. Skips OpenMP.",
            "group": "none",
            "dependsOn": "Build All",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Quick Test Benchmark",
            "type": "shell",
            "command": "bash",
            "args": ["scripts/test_benchmark.sh"],
            "detail": "Run a quick 1-epoch validation benchmark (sequential + OpenMP 2 threads + MPI 2 processes) to verify the benchmark infrastructure works",
            "group": "none",
            "dependsOn": "Build All",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Re-plot Results",
            "type": "shell",
            "command": "python",
            "args": ["scripts/plot_results.py"],
            "detail": "Re-generate summary tables and all plots from the most recent run directory in results/. Useful for regenerating plots without re-running training.",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },

        // =====================================================================
        // Docker tasks — run inside containers, no local toolchain required
        // =====================================================================
        {
            "label": "Docker: Build Image",
            "type": "shell",
            "command": "docker",
            "args": ["compose", "build"],
            "detail": "Build the Docker image (compiles all binaries inside the container)",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Rebuild Image",
            "type": "shell",
            "command": "docker",
            "args": ["compose", "build", "--no-cache"],
            "detail": "Rebuild the Docker image from scratch without layer caching",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Download MNIST",
            "type": "shell",
            "command": "docker",
            "args": ["compose", "run", "--rm", "download-data"],
            "detail": "Download MNIST dataset into a persistent Docker volume (one-time setup)",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Train Sequential",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "CONFIG=configs/${input:configFile}.conf NUM_RUNS=${input:numRuns} docker compose run --rm train-seq"
            ],
            "detail": "Train sequentially inside Docker (no local toolchain needed)",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Train OpenMP",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "CONFIG=configs/${input:configFile}.conf THREADS=${input:numThreads} NUM_RUNS=${input:numRuns} docker compose run --rm train-omp"
            ],
            "detail": "Train with OpenMP parallelization inside Docker",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Train MPI",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "CONFIG=configs/${input:configFile}.conf PROCS=${input:numProcesses} NUM_RUNS=${input:numRuns} docker compose run --rm train-mpi"
            ],
            "detail": "Train with MPI distributed parallelization inside Docker",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Run Full Benchmark",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "NUM_RUNS=${input:numRuns} docker compose run --rm benchmark"
            ],
            "detail": "Run the complete benchmark suite inside Docker across all configs and parallelism levels",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Benchmark OpenMP",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "NUM_RUNS=${input:numRuns} SKIP_MPI=1 docker compose run --rm benchmark"
            ],
            "detail": "Run benchmark with sequential + OpenMP inside Docker. Skips MPI.",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Benchmark MPI",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "NUM_RUNS=${input:numRuns} SKIP_OMP=1 docker compose run --rm benchmark"
            ],
            "detail": "Run benchmark with sequential + MPI inside Docker. Skips OpenMP.",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Quick Test Benchmark",
            "type": "shell",
            "command": "docker",
            "args": ["compose", "run", "--rm", "test-benchmark"],
            "detail": "Run a quick 1-epoch validation benchmark inside Docker to verify everything works",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Run Tests",
            "type": "shell",
            "command": "docker",
            "args": ["compose", "run", "--rm", "test"],
            "detail": "Build and run all unit tests inside Docker (uses the builder stage with compiler)",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Plot Results",
            "type": "shell",
            "command": "docker",
            "args": ["compose", "run", "--rm", "plot"],
            "detail": "Re-generate plots from the most recent results using Python/matplotlib inside Docker",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
